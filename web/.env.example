# =====================================================================
# WakeelHub Pakistan - Environment Variables (TEMPLATE)
# =====================================================================
# This is a safe, committable template. DO NOT put real secrets here.
# Copy it to `.env.local` and fill in your own values:
#     cp .env.example .env.local
# =====================================================================

# Supabase project credentials (Dashboard → Project Settings → API)
# Project URL:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project API keys → "anon" / "public" key (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project API keys → "service_role" / "secret" key.
# SERVER-SIDE ONLY - bypasses Row Level Security. Never expose to the
# browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Public site URL - canonical links, sitemap, metadata.
# Local dev: http://localhost:3000   |   Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment gateway keys (wire up before going to production)
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
