# =====================================================================
# Wakeel360 Pakistan - Environment Variables (TEMPLATE)
# =====================================================================
# Safe, committable template. DO NOT put real secrets here.
# Local dev:  cp .env.example .env.local   then fill in your values.
# Vercel:     add these in Project -> Settings -> Environment Variables.
# =====================================================================

# --- REQUIRED -------------------------------------------------------

# Supabase project URL (Dashboard -> Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase "anon" / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase "service_role" / secret key.
# SERVER-SIDE ONLY - bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Canonical public site URL - used for metadata, sitemap and canonical links.
# Local dev: http://localhost:3000   |   Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OPTIONAL (only needed for payments / transactional emails) -----

# Absolute app origin used to build payment redirect + email links.
# Defaults to NEXT_PUBLIC_SITE_URL behaviour when omitted.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment gateway checkout endpoints (leave blank to use sandbox/defaults)
JAZZCASH_CHECKOUT_URL=
EASYPAY_CHECKOUT_URL=

